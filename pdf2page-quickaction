#!/bin/zsh
# Finder Quick Action wrapper around pdf2page.
#
# Services are launched by launchd with a bare PATH, so uv (~/.local/bin),
# poppler (/opt/homebrew/bin) and pdfjam (/Library/TeX/texbin) all have to be
# put back before pdf2page can find them.  Quick Actions also swallow stdout
# and stderr, and notifications posted from a service are silently dropped, so
# every run ends in a dialog: success offers to open the result, a skip offers
# to make it anyway (--force), and a failure shows pdf2page's own stderr.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/Library/TeX/texbin:/usr/bin:/bin:/usr/sbin:/sbin"

PDF2PAGE="$HOME/bin/pdf2page"

dialog() {        # title message button...  -> prints the button clicked
  osascript -e 'on run argv' \
            -e 'set btns to items 3 thru -1 of argv' \
            -e 'display dialog (item 2 of argv) with title (item 1 of argv) buttons btns default button (count of btns) with icon note' \
            -e 'return button returned of result' \
            -e 'end run' -- "$@" 2>/dev/null
}

typeset -a ok_in ok_out skipped failed report

run() {           # file [extra args] - runs pdf2page and records the outcome
  local f=$1; shift
  local base=${f:t} errfile out rc msg
  errfile=$(mktemp -t pdf2page)
  out=$("$PDF2PAGE" "$@" "$f" 2>"$errfile"); rc=$?
  msg=$(<"$errfile"); rm -f "$errfile"
  local -a lines=("${(@f)msg}") m
  if (( rc == 0 )); then
    ok_in+=("$f"); ok_out+=("$out")
    m=("${(@M)lines:#*text ends at*}")
    report+=("✓ $base -> ${out:t}  (${${m[1]#pdf2page: }:-done})")
  elif [[ $msg == *"skipping"* ]]; then
    skipped+=("$f")
    m=("${(@M)lines:#*skipping*}")
    report+=("– $base skipped: ${m[1]#pdf2page: skipping - }")
  else
    failed+=("$f")
    report+=("✗ $base failed:"$'\n'"${msg:-pdf2page exited $rc with no output.}")
  fi
}

(( $# )) || exit 0

for f in "$@"; do run "$f"; done

while true; do
  typeset -a buttons=()
  (( $#skipped )) && buttons+=("Make anyway")
  (( $#ok_out == 1 )) && buttons+=("Open")
  (( $#ok_out > 1 )) && buttons+=("Open all")
  buttons+=("OK")

  title="pdf2page"
  (( $# == 1 && $#ok_out )) && title="pdf2page - done"
  (( $# == 1 && $#skipped )) && title="pdf2page - skipped"
  (( $#failed )) && title="pdf2page - failed"

  choice=$(dialog "$title" "${(pj:\n\n:)report}" "${buttons[@]}")

  case $choice in
    "Make anyway")
      local_skipped=("${skipped[@]}")
      skipped=() report=()
      ok_in=() ok_out=() failed=()
      for f in "${local_skipped[@]}"; do run "$f" --force; done
      ;;
    Open|"Open all")
      open "${ok_out[@]}"
      break ;;
    *)
      break ;;
  esac
done
